# Copy to .env, which is git-ignored. Nothing here is read at build time.
#
# openrouter — one key, every model worth comparing, which is what makes the
# question in doc/11 answerable: the same tree against several models is a
# comparison; the same tree against the one model we have credentials for is an
# anecdote.
AI_OS_PROVIDER=openrouter
AI_OS_MODEL=google/gemini-3.5-flash
OPENROUTER_API_KEY=

# google  — direct AI SDK provider; needs GOOGLE_GENERATIVE_AI_API_KEY instead.
# compatible — any OpenAI-compatible endpoint; needs AI_OS_BASE_URL.
